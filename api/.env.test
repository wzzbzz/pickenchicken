# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Same DB name as dev's DATABASE_URL — config/packages/doctrine.yaml already
# appends dbname_suffix '_test' (or '_testN' under ParaTest) in the test env,
# so this resolves to a separate "pickenchicken_test" database. DAMA\Doctrine
# TestBundle wraps each test in a transaction that's rolled back, but tests
# still need their own database so schema state doesn't collide with dev data.
DATABASE_URL="postgresql://chicken:chicken@127.0.0.1:5433/pickenchicken?serverVersion=16&charset=utf8"
